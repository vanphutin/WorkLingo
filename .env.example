DATABASE_URL=postgresql://worklingo:worklingo@127.0.0.1:5432/worklingo
API_PORT=4000
WEB_PORT=3000
WORKLINGO_DATA_DIR=./data
SESSION_SECRET=worklingo-local-development-secret-change-me
WORKLINGO_API_URL=http://127.0.0.1:4000
WORKLINGO_ADMIN_EMAIL=admin@worklingo.local
WORKLINGO_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Provider-free local defaults. Azure Speech is an optional limited external allowance.
WORKLINGO_STT_PROVIDER=fake
WORKLINGO_LANGUAGE_EVALUATION_PROVIDER=fake
WORKLINGO_TTS_PROVIDER=fake-tts
# Keep both Azure values blank in local simulation mode. Never expose them to the web app.
MICROSOFT_SPEECH_KEY=
MICROSOFT_SPEECH_REGION=
MICROSOFT_SPEECH_LANGUAGE=en-US
MICROSOFT_SPEECH_VOICE=en-US-JennyNeural
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Use discovery to enable live evaluation with independent OpenAI fallback.
# The temporary free offer is provider policy, not a permanent billing guarantee.
DISCOVERY_API_KEY=
DISCOVERY_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
DISCOVERY_MODEL=qwen3.8-27b
AI_ROUTING_ENABLED=true
AI_DEFAULT_PROVIDER=discovery
AI_FALLBACK_ENABLED=true
AI_MAX_OUTPUT_TOKENS=2048
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_ATTEMPTS=3
RECORDING_RETENTION_DAYS=7
WRITING_DRAFT_RETENTION_DAYS=30
RECORDING_MAX_BYTES=10485760
RECORDING_MAX_DURATION_SECONDS=120
JOB_WORKER_ENABLED=true
JOB_WORKER_POLL_INTERVAL_MS=1000
JOB_WORKER_LEASE_MS=30000

# Optional isolated Playwright ports; these avoid collisions with pnpm dev.
WORKLINGO_E2E_API_PORT=34100
WORKLINGO_E2E_WEB_PORT=33100
