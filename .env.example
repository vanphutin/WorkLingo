DATABASE_URL=postgresql://worklingo:worklingo@127.0.0.1:5432/worklingo
API_PORT=4000
WEB_PORT=3000
WORKLINGO_DATA_DIR=./data
SESSION_SECRET=worklingo-local-development-secret-change-me
WORKLINGO_API_URL=http://127.0.0.1:4000
WORKLINGO_ADMIN_EMAIL=admin@worklingo.local
WORKLINGO_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Increment 4 defaults are provider-free. Select a real provider only after adding credentials.
WORKLINGO_STT_PROVIDER=fake
WORKLINGO_LANGUAGE_EVALUATION_PROVIDER=fake
WORKLINGO_TTS_PROVIDER=fake
MICROSOFT_SPEECH_KEY=
MICROSOFT_SPEECH_REGION=
MICROSOFT_SPEECH_LANGUAGE=en-US
MICROSOFT_SPEECH_VOICE=en-US-JennyNeural
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_ATTEMPTS=3
RECORDING_RETENTION_DAYS=7
WRITING_DRAFT_RETENTION_DAYS=30
RECORDING_MAX_BYTES=10485760
RECORDING_MAX_DURATION_SECONDS=120
