{
  "name": "@worklingo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/run-api.mjs dev",
    "db:seed": "prisma db seed",
