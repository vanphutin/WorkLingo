generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  CONTENT_ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OnboardingStatus {
  PENDING
  COMPLETE
}

enum OnboardingMethod {
  SELF_SELECTED
  PLACEMENT
  MIGRATED
}

model User {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String                     @unique
  displayName                String
  passwordHash               String
  role                       UserRole                   @default(LEARNER)
  status                     UserStatus                 @default(ACTIVE)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  profile                    LearnerProfile?
  aiRoutingSetting           AiRoutingSetting?
  sessions                   UserSession[]
  learningSessions           LearningSession[]
  createdContentImports      ContentImport[]            @relation("ContentImportCreatedBy")
  updatedContentImports      ContentImport[]            @relation("ContentImportUpdatedBy")
  jobs                       Job[]
  recordings                 Recording[]
  activityDrafts             ActivityDraft[]
  mutationReceipts           MutationReceipt[]
  auditLogs                  AuditLog[]
  masteryRecords             MasteryRecord[]
  masteryEvents              MasteryEvent[]
  errorBankEntries           ErrorBankEntry[]
  checkpointAssessments      CheckpointAssessment[]
  progressionConfirmations   ProgressionConfirmation[]
  placementAttempts          PlacementAttempt[]
  updatedAudioSystemSettings AudioSystemSetting[]       @relation("AudioSystemSettingUpdatedBy")
  studyDays                  LearnerStudyDay[]
  studySessions              LearnerStudySession[]
  engagementWeeks            LearnerEngagementWeek[]
  programEnrollments         LearnerProgramEnrollment[]
  createdOrientationMedia    OrientationMediaAsset[]    @relation("OrientationMediaCreatedBy")
  orientationProgress        OrientationProgress[]
  ieltsBridgeProgress        IeltsBridgeProgress[]
  ieltsIntegratedSessions    IeltsIntegratedSession[]
  ieltsBandJourneys          IeltsBandJourney[]
  ieltsIntroductionVisits    IeltsIntroductionVisit[]
  ieltsMockAttempts          IeltsMockAttempt[]
  ieltsMockReviews           IeltsMockReview[]          @relation("IeltsMockReviewReviewer")
}

model AiRoutingSetting {
  id                String   @id
  userId            String?  @unique @db.Uuid
  preferredProvider String   @default("system-default")
  fallbackEnabled   Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearnerProfile {
  userId           String            @id @db.Uuid
  currentLevelCode String            @default("FOUNDATION_1")
  activeProgramId  String?           @db.Uuid
  onboardingStatus OnboardingStatus  @default(PENDING)
  onboardingMethod OnboardingMethod?
  onboardedAt      DateTime?
  weeklyTargetDays Int               @default(3)
  locale           String            @default("vi")
  timezone         String            @default("Asia/Ho_Chi_Minh")
  recordingConsent Boolean           @default(false)
  ieltsEarlyAccess Boolean           @default(false)
  audioSourceId    String            @default("system-default")
  browserVoiceId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeProgram    LearningProgram?  @relation(fields: [activeProgramId], references: [id], onDelete: Restrict)

  @@index([activeProgramId])
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ContentStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum OrientationMediaKind {
  AUDIO
  IMAGE
}

enum ActivityType {
  reading
  listening
  speaking
  writing
}

enum LearningBlockType {
  activate
  readDecode
  listenReason
  respond
}

enum MissionPurpose {
  LEARNING
  PLACEMENT
}

enum ProgramAvailabilityStatus {
  AVAILABLE
  COMING_SOON
  IN_DEVELOPMENT
  BETA
  DISABLED
}

model LearningProgram {
  vocabularyBindings VocabularyCurriculumBinding[]
  vocabularyAssignments VocabularyProgramAssignment[]
  id                 String                     @id @default(uuid()) @db.Uuid
  slug               String                     @unique
  name               String
  description        String
  learningGoal       String
  proficiencyLabel   String
  iconKey            String
  availabilityStatus ProgramAvailabilityStatus
  displayOrder       Int                        @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  paths              LearningPath[]
  enrollments        LearnerProgramEnrollment[]
  activeProfiles     LearnerProfile[]
}

model LearnerProgramEnrollment {
  id                    String                 @id @default(uuid()) @db.Uuid
  learnerId             String                 @db.Uuid
  programId             String                 @db.Uuid
  currentLevelId        String?                @db.Uuid
  revision              Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  learner               User                   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  program               LearningProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  currentLevel          Level?                 @relation(fields: [currentLevelId], references: [id], onDelete: Restrict)
  curriculumCompletions CurriculumCompletion[]

  @@unique([learnerId, programId])
  @@index([programId])
  @@index([currentLevelId])
}

model LearningPath {
  vocabularyBindings VocabularyCurriculumBinding[]
  id        String          @id @default(uuid()) @db.Uuid
  programId String          @default("10000000-0000-4000-8000-000000000002") @db.Uuid
  slug      String          @unique
  name      String
  status    ContentStatus   @default(DRAFT)
  revision  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  program   LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  levels    Level[]

  @@index([programId, status])
}

model Level {
  vocabularyBindings VocabularyCurriculumBinding[]
  id            String                     @id @default(uuid()) @db.Uuid
  pathId        String                     @db.Uuid
  code          String                     @unique
  name          String
  cefrReference String
  order         Int
  status        ContentStatus              @default(DRAFT)
  revision      Int                        @default(1)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  path          LearningPath               @relation(fields: [pathId], references: [id], onDelete: Restrict)
  missions      Mission[]
  enrollments   LearnerProgramEnrollment[]

  @@unique([pathId, order])
  @@index([pathId, order])
}

model Mission {
  vocabularyBindings VocabularyCurriculumBinding[]
  id                   String                @id @default(uuid()) @db.Uuid
  levelId              String                @db.Uuid
  slug                 String                @unique
  title                String
  objective            String
  order                Int
  purpose              MissionPurpose        @default(LEARNING)
  status               ContentStatus         @default(DRAFT)
  revision             Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  level                Level                 @relation(fields: [levelId], references: [id], onDelete: Restrict)
  lessons              MissionLesson[]
  learningSessions     LearningSession[]
  curriculumDefinition CurriculumDefinition?
  curriculumRevisions  CurriculumRevision[]

  @@unique([levelId, order])
  @@index([levelId, order])
}

model Lesson {
  id                        String          @id @default(uuid()) @db.Uuid
  slug                      String          @unique
  currentPublishedVersionId String?         @db.Uuid
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  currentPublishedVersion   LessonVersion?  @relation("LessonCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  missions                  MissionLesson[]
  versions                  LessonVersion[]
  contentImports            ContentImport[]
  topicGroupId              String?         @db.Uuid
  topicGroup                IntermediateTopicGroup? @relation(fields: [topicGroupId], references: [id], onDelete: SetNull)

  @@index([topicGroupId])
}

model MissionLesson {
  missionId String  @db.Uuid
  lessonId  String  @db.Uuid
  order     Int
  revision  Int     @default(1)
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([missionId, lessonId])
  @@unique([missionId, order])
  @@index([lessonId])
}

model LessonVersion {
  vocabularyBindings VocabularyCurriculumBinding[]
  id                String                       @id @default(uuid()) @db.Uuid
  lessonId          String                       @db.Uuid
  version           Int
  title             String
  status            ContentStatus                @default(DRAFT)
  sourceHash        String
  parsedContent     Json
  publishedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  lesson            Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  contentBlocks     ContentBlock[]
  activities        Activity[]
  wordBanks         LessonVersionWordBank[]
  learningSessions  LearningSession[]
  audioArtifacts    LessonVersionAudioArtifact[]
  contentImports    ContentImport[]
  currentForLesson  Lesson[]                     @relation("LessonCurrentPublishedVersion")
  masteryRecords    MasteryRecord[]
  masteryEvents     MasteryEvent[]
  errorBankEntries  ErrorBankEntry[]
  placementAttempts PlacementAttempt[]

  checkpointAssessments CheckpointAssessment[]
  evaluationResults     EvaluationResult[]
  curriculumBindings    CurriculumRevisionLesson[]
  vocabularyUsages      LessonVocabularyUsage[]

  @@unique([lessonId, version])
}

model ContentBlock {
  id              String        @id @default(uuid()) @db.Uuid
  lessonVersionId String        @db.Uuid
  slug            String
  type            String
  order           Int
  text            String
  metadata        Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@unique([lessonVersionId, slug])
  @@unique([lessonVersionId, order])
}

model Activity {
  id                      String            @id @default(uuid()) @db.Uuid
  lessonVersionId         String            @db.Uuid
  slug                    String
  activityType            ActivityType
  learningBlock           LearningBlockType
  order                   Int
  skills                  ActivityType[]
  contentReferences       String[]
  languageBlockReferences String[]
  payload                 Json
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  lessonVersion           LessonVersion     @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  attempts                ActivityAttempt[]
  errorBankEntries        ErrorBankEntry[]
  recordings              Recording[]
  activityDrafts          ActivityDraft[]

  @@unique([lessonVersionId, slug])
  @@unique([lessonVersionId, order])
}

model WordBank {
  id             String                  @id @default(uuid()) @db.Uuid
  slug           String                  @unique
  name           String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  languageBlocks LanguageBlock[]
  lessonVersions LessonVersionWordBank[]
  versions       WordBankVersion[]
}

model WordBankVersion {
  vocabularyBindings VocabularyCurriculumBinding[]
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordBankId     String                  @db.Uuid
  name           String
  sourceHash     String
  version        Int
  createdAt      DateTime                @default(now())
  wordBank       WordBank                @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  languageBlocks LanguageBlockVersion[]
  lessonVersions LessonVersionWordBank[]

  @@unique([wordBankId, version])
  @@unique([wordBankId, sourceHash])
  @@index([wordBankId])
}

model LanguageBlockVersion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordBankVersionId String          @db.Uuid
  slug              String
  canonicalForm     String
  meaning           String
  pronunciation     String
  collocations      String[]
  grammarPattern    String
  examples          String[]
  commonErrors      String[]
  cefrLevel         String
  transferContexts  String[]
  createdAt         DateTime        @default(now())
  wordBankVersion   WordBankVersion @relation(fields: [wordBankVersionId], references: [id], onDelete: Cascade)

  @@unique([wordBankVersionId, slug])
  @@index([wordBankVersionId])
}

model LessonVersionWordBank {
  lessonVersionId   String           @db.Uuid
  wordBankId        String           @db.Uuid
  wordBankVersionId String?          @db.Uuid
  lessonVersion     LessonVersion    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  wordBank          WordBank         @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  wordBankVersion   WordBankVersion? @relation(fields: [wordBankVersionId], references: [id], onDelete: Restrict)

  @@id([lessonVersionId, wordBankId])
  @@index([wordBankVersionId])
  @@index([wordBankId])
}

model LanguageBlock {
  lexicalLinks VocabularyLegacyLink[]
  id               String           @id @default(uuid()) @db.Uuid
  wordBankId       String           @db.Uuid
  slug             String           @unique
  canonicalForm    String
  normalizedExpression String @default("")
  meaning          String
  pronunciation    String
  collocations     String[]
  grammarPattern   String
  examples         String[]
  commonErrors     String[]
  cefrLevel        String
  transferContexts String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  wordBank         WordBank         @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  vocabularyUsages LessonVocabularyUsage[]
  masteryRecords   MasteryRecord[]
  masteryEvents    MasteryEvent[]
  errorBankEntries ErrorBankEntry[]

  @@index([wordBankId])
  @@index([normalizedExpression])
}

model LessonVocabularyUsage {
  lessonVersionId    String @db.Uuid
  sourceWordBankSlug String
  sourceSlug         String
  languageBlockId    String @db.Uuid
  decision           String
  topicGroupId       String? @db.Uuid
  topicName          String?
  topicNameEn        String?
  lessonVersion      LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  languageBlock      LanguageBlock @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  topicGroup         IntermediateTopicGroup? @relation(fields: [topicGroupId], references: [id], onDelete: SetNull)

  @@id([lessonVersionId, sourceWordBankSlug, sourceSlug])
  @@index([languageBlockId])
  @@index([topicGroupId])
}

enum LearningSessionStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionBlockStatus {
  AVAILABLE
  COMPLETED
}

enum AttemptEvaluationStatus {
  SUBMITTED
  QUEUED
  PROCESSING
  EVALUATED
  EVALUATION_FAILED
}

enum PlacementAttemptStatus {
  IN_PROGRESS
  PROCESSING
  ACTION_REQUIRED
  RECOMMENDED
  CONFIRMED
}

model LearningSession {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId             String                 @db.Uuid
  clientSessionId       String                 @db.Uuid
  missionId             String                 @db.Uuid
  lessonVersionId       String                 @db.Uuid
  curriculumRevisionId  String?                @db.Uuid
  durationMinutes       Int
  planSnapshot          Json
  status                LearningSessionStatus  @default(PLANNED)
  currentCheckpoint     Int                    @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  learner               User                   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mission               Mission                @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lessonVersion         LessonVersion          @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  curriculumRevision    CurriculumRevision?    @relation(fields: [curriculumRevisionId], references: [id], onDelete: Restrict)
  blocks                SessionBlock[]
  attempts              ActivityAttempt[]
  recordings            Recording[]
  activityDrafts        ActivityDraft[]
  checkpointAssessments CheckpointAssessment[]
  ieltsTopicSession     IeltsTopicSession?
  placementAttempt      PlacementAttempt?
  studySession          LearnerStudySession?

  @@unique([learnerId, clientSessionId])
  @@unique([id, learnerId])
  @@unique([id, learnerId, lessonVersionId])
  @@index([learnerId, status, createdAt])
  @@index([missionId])
  @@index([lessonVersionId])
  @@index([curriculumRevisionId])
}

model CurriculumDefinition {
  id        String        @id @default(uuid()) @db.Uuid
  missionId String        @unique @db.Uuid
  revision  Int           @default(1)
  status    ContentStatus @default(DRAFT)
  content   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  mission   Mission       @relation(fields: [missionId], references: [id], onDelete: Restrict)
}

model CurriculumRevision {
  id            String                     @id @default(uuid()) @db.Uuid
  missionId     String                     @db.Uuid
  revision      Int
  snapshot      Json
  status        ContentStatus              @default(PUBLISHED)
  publishedAt   DateTime                   @default(now())
  archivedAt    DateTime?
  mission       Mission                    @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lessons       CurriculumRevisionLesson[]
  prerequisites CurriculumPrerequisite[]   @relation("CurriculumDependencies")
  dependents    CurriculumPrerequisite[]   @relation("CurriculumDependents")
  sessions      LearningSession[]
  completions   CurriculumCompletion[]

  @@unique([missionId, revision])
  @@index([missionId, status])
}

model CurriculumRevisionLesson {
  curriculumRevisionId String             @db.Uuid
  lessonVersionId      String             @db.Uuid
  order                Int
  curriculumRevision   CurriculumRevision @relation(fields: [curriculumRevisionId], references: [id], onDelete: Restrict)
  lessonVersion        LessonVersion      @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@id([curriculumRevisionId, lessonVersionId])
  @@unique([curriculumRevisionId, order])
  @@index([lessonVersionId])
}

model CurriculumPrerequisite {
  curriculumRevisionId   String             @db.Uuid
  prerequisiteRevisionId String             @db.Uuid
  curriculumRevision     CurriculumRevision @relation("CurriculumDependencies", fields: [curriculumRevisionId], references: [id], onDelete: Restrict)
  prerequisiteRevision   CurriculumRevision @relation("CurriculumDependents", fields: [prerequisiteRevisionId], references: [id], onDelete: Restrict)

  @@id([curriculumRevisionId, prerequisiteRevisionId])
  @@index([prerequisiteRevisionId])
}

model CurriculumCompletion {
  id                   String                   @id @default(uuid()) @db.Uuid
  enrollmentId         String                   @db.Uuid
  curriculumRevisionId String                   @db.Uuid
  policyVersion        String
  evidenceSnapshot     Json
  completedAt          DateTime                 @default(now())
  enrollment           LearnerProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  curriculumRevision   CurriculumRevision       @relation(fields: [curriculumRevisionId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, curriculumRevisionId])
  @@index([curriculumRevisionId])
}

model PlacementAttempt {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId            String                 @db.Uuid
  clientAttemptId      String                 @db.Uuid
  learningSessionId    String                 @unique @db.Uuid
  lessonVersionId      String                 @db.Uuid
  policyVersion        String                 @default("workplace-placement-v1")
  status               PlacementAttemptStatus @default(IN_PROGRESS)
  skillResults         Json                   @default("{}")
  recommendedLevelCode String?
  explanation          Json?
  confirmedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  learner              User                   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learningSession      LearningSession        @relation(fields: [learningSessionId, learnerId, lessonVersionId], references: [id, learnerId, lessonVersionId], onDelete: Cascade)
  lessonVersion        LessonVersion          @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@unique([learnerId, clientAttemptId])
  @@unique([learningSessionId, learnerId, lessonVersionId])
  @@index([learnerId, status, updatedAt])
  @@index([lessonVersionId])
}

model CheckpointAssessment {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId          String                   @db.Uuid
  clientAssessmentId String                   @db.Uuid
  sessionId          String                   @db.Uuid
  lessonVersionId    String                   @db.Uuid
  levelCode          String
  policyVersion      String
  status             String
  skills             Json
  reinforcement      Json
  evidenceSnapshot   Json
  canAdvance         Boolean
  nextLevelCode      String?
  createdAt          DateTime                 @default(now())
  learner            User                     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session            LearningSession          @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  lessonVersion      LessonVersion            @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  confirmation       ProgressionConfirmation?

  @@unique([learnerId, clientAssessmentId])
  @@unique([id, learnerId])
  @@index([learnerId, levelCode, createdAt])
  @@index([sessionId, learnerId])
  @@index([lessonVersionId])
}

model ProgressionConfirmation {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId     String               @db.Uuid
  assessmentId  String               @unique @db.Uuid
  fromLevelCode String
  toLevelCode   String?
  createdAt     DateTime             @default(now())
  learner       User                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  assessment    CheckpointAssessment @relation(fields: [assessmentId, learnerId], references: [id, learnerId], onDelete: Cascade)

  @@unique([assessmentId, learnerId])
  @@index([learnerId])
}

model SessionBlock {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String             @db.Uuid
  type          LearningBlockType
  order         Int
  targetMinutes Int
  activityIds   String[]           @db.Uuid
  status        SessionBlockStatus @default(AVAILABLE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  session       LearningSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
}

model ActivityAttempt {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId          String                  @db.Uuid
  sessionId          String                  @db.Uuid
  activityId         String                  @db.Uuid
  clientAttemptId    String                  @db.Uuid
  rawResponse        Json
  normalizedResponse Json?
  evaluationStatus   AttemptEvaluationStatus
  score              Float?
  feedback           String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  session            LearningSession         @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  activity           Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  masteryEvents      MasteryEvent[]
  recording          Recording?
  evaluationResults  EvaluationResult[]

  @@unique([learnerId, clientAttemptId])
  @@index([sessionId])
  @@index([activityId])
  @@index([sessionId, activityId])
}

model Recording {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId             String          @db.Uuid
  sessionId             String          @db.Uuid
  activityId            String          @db.Uuid
  attemptId             String          @unique @db.Uuid
  storageKey            String          @unique
  mimeType              String
  byteSize              Int
  checksum              String
  durationSeconds       Float?
  consentPolicyVersion  String
  consentScope          String
  consentAcceptedAt     DateTime
  transcript            String?
  speechMetrics         Json?
  providerName          String?
  providerConfigVersion String?
  retentionUntil        DateTime?
  deletionRequestedAt   DateTime?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  learner               User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session               LearningSession @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  activity              Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  attempt               ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@index([sessionId, learnerId])
  @@index([activityId])
  @@index([retentionUntil, deletedAt])
}

model EvaluationResult {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId               String          @db.Uuid
  lessonVersionId         String          @db.Uuid
  rubricId                String
  rubricVersion           String
  inputHash               String
  providerName            String
  providerModel           String?
  providerConfigVersion   String
  scores                  Json
  score                   Float
  feedback                Json
  speechMetricsProvenance Json?
  completedAt             DateTime
  createdAt               DateTime        @default(now())
  attempt                 ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lessonVersion           LessonVersion   @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, rubricVersion])
  @@index([attemptId, createdAt])
