generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  CONTENT_ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                    @unique
  displayName              String
  passwordHash             String
  role                     UserRole                  @default(LEARNER)
  status                   UserStatus                @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  profile                  LearnerProfile?
  sessions                 UserSession[]
  learningSessions         LearningSession[]
  createdContentImports    ContentImport[]           @relation("ContentImportCreatedBy")
  updatedContentImports    ContentImport[]           @relation("ContentImportUpdatedBy")
  jobs                     Job[]
  recordings               Recording[]
  activityDrafts           ActivityDraft[]
  mutationReceipts         MutationReceipt[]
  auditLogs                AuditLog[]
  masteryRecords           MasteryRecord[]
  masteryEvents            MasteryEvent[]
  errorBankEntries         ErrorBankEntry[]
  checkpointAssessments    CheckpointAssessment[]
  progressionConfirmations ProgressionConfirmation[]
}

model LearnerProfile {
  userId           String   @id @db.Uuid
  currentLevelCode String   @default("FOUNDATION_1")
  locale           String   @default("vi")
  timezone         String   @default("Asia/Ho_Chi_Minh")
  recordingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ContentStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum ActivityType {
  reading
  listening
  speaking
  writing
}

enum LearningBlockType {
  activate
  readDecode
  listenReason
  respond
}

model LearningPath {
  id        String        @id @default(uuid()) @db.Uuid
  slug      String        @unique
  name      String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  levels    Level[]
}

model Level {
  id            String       @id @default(uuid()) @db.Uuid
  pathId        String       @db.Uuid
  code          String       @unique
  name          String
  cefrReference String
  order         Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  path          LearningPath @relation(fields: [pathId], references: [id], onDelete: Restrict)
  missions      Mission[]

  @@unique([pathId, order])
}

model Mission {
  id               String            @id @default(uuid()) @db.Uuid
  levelId          String            @db.Uuid
  slug             String            @unique
  title            String
  objective        String
  order            Int
  status           ContentStatus     @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  level            Level             @relation(fields: [levelId], references: [id], onDelete: Restrict)
  lessons          MissionLesson[]
  learningSessions LearningSession[]

  @@unique([levelId, order])
}

model Lesson {
  id                        String          @id @default(uuid()) @db.Uuid
  slug                      String          @unique
  currentPublishedVersionId String?         @db.Uuid
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  currentPublishedVersion   LessonVersion?  @relation("LessonCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  missions                  MissionLesson[]
  versions                  LessonVersion[]
  contentImports            ContentImport[]
}

model MissionLesson {
  missionId String  @db.Uuid
  lessonId  String  @db.Uuid
  order     Int
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([missionId, lessonId])
  @@unique([missionId, order])
  @@index([lessonId])
}

model LessonVersion {
  id               String                       @id @default(uuid()) @db.Uuid
  lessonId         String                       @db.Uuid
  version          Int
  title            String
  status           ContentStatus                @default(DRAFT)
  sourceHash       String
  parsedContent    Json
  publishedAt      DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  lesson           Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  contentBlocks    ContentBlock[]
  activities       Activity[]
  wordBanks        LessonVersionWordBank[]
  learningSessions LearningSession[]
  audioArtifacts   LessonVersionAudioArtifact[]
  contentImports   ContentImport[]
  currentForLesson Lesson[]                     @relation("LessonCurrentPublishedVersion")
  masteryRecords   MasteryRecord[]
  masteryEvents    MasteryEvent[]
  errorBankEntries ErrorBankEntry[]

  checkpointAssessments CheckpointAssessment[]
  evaluationResults     EvaluationResult[]

  @@unique([lessonId, version])
}

model ContentBlock {
  id              String        @id @default(uuid()) @db.Uuid
  lessonVersionId String        @db.Uuid
  slug            String
  type            String
  order           Int
  text            String
  metadata        Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@unique([lessonVersionId, slug])
  @@unique([lessonVersionId, order])
}

model Activity {
  id                      String            @id @default(uuid()) @db.Uuid
  lessonVersionId         String            @db.Uuid
  slug                    String
  activityType            ActivityType
  learningBlock           LearningBlockType
  order                   Int
  skills                  ActivityType[]
  contentReferences       String[]
  languageBlockReferences String[]
  payload                 Json
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  lessonVersion           LessonVersion     @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  attempts                ActivityAttempt[]
  errorBankEntries        ErrorBankEntry[]
  recordings              Recording[]
  activityDrafts          ActivityDraft[]

  @@unique([lessonVersionId, slug])
  @@unique([lessonVersionId, order])
}

model WordBank {
  id             String                  @id @default(uuid()) @db.Uuid
  slug           String                  @unique
  name           String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  languageBlocks LanguageBlock[]
  lessonVersions LessonVersionWordBank[]
  versions       WordBankVersion[]
}

model WordBankVersion {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordBankId     String                  @db.Uuid
  name           String
  sourceHash     String
  version        Int
  createdAt      DateTime                @default(now())
  wordBank       WordBank                @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  languageBlocks LanguageBlockVersion[]
  lessonVersions LessonVersionWordBank[]

  @@unique([wordBankId, version])
  @@unique([wordBankId, sourceHash])
  @@index([wordBankId])
}

model LanguageBlockVersion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordBankVersionId String          @db.Uuid
  slug              String
  canonicalForm     String
  meaning           String
  pronunciation     String
  collocations      String[]
  grammarPattern    String
  examples          String[]
  commonErrors      String[]
  cefrLevel         String
  transferContexts  String[]
  createdAt         DateTime        @default(now())
  wordBankVersion   WordBankVersion @relation(fields: [wordBankVersionId], references: [id], onDelete: Cascade)

  @@unique([wordBankVersionId, slug])
  @@index([wordBankVersionId])
}

model LessonVersionWordBank {
  lessonVersionId   String           @db.Uuid
  wordBankId        String           @db.Uuid
  wordBankVersionId String?          @db.Uuid
  lessonVersion     LessonVersion    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  wordBank          WordBank         @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  wordBankVersion   WordBankVersion? @relation(fields: [wordBankVersionId], references: [id], onDelete: Restrict)

  @@id([lessonVersionId, wordBankId])
  @@index([wordBankVersionId])
  @@index([wordBankId])
}

model LanguageBlock {
  id               String           @id @default(uuid()) @db.Uuid
  wordBankId       String           @db.Uuid
  slug             String           @unique
  canonicalForm    String
  meaning          String
  pronunciation    String
  collocations     String[]
  grammarPattern   String
  examples         String[]
  commonErrors     String[]
  cefrLevel        String
  transferContexts String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  wordBank         WordBank         @relation(fields: [wordBankId], references: [id], onDelete: Restrict)
  masteryRecords   MasteryRecord[]
  masteryEvents    MasteryEvent[]
  errorBankEntries ErrorBankEntry[]

  @@index([wordBankId])
}

enum LearningSessionStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionBlockStatus {
  AVAILABLE
  COMPLETED
}

enum AttemptEvaluationStatus {
  SUBMITTED
  QUEUED
  PROCESSING
  EVALUATED
  EVALUATION_FAILED
}

model LearningSession {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId             String                 @db.Uuid
  clientSessionId       String                 @db.Uuid
  missionId             String                 @db.Uuid
  lessonVersionId       String                 @db.Uuid
  durationMinutes       Int
  planSnapshot          Json
  status                LearningSessionStatus  @default(PLANNED)
  currentCheckpoint     Int                    @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  learner               User                   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mission               Mission                @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lessonVersion         LessonVersion          @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  blocks                SessionBlock[]
  attempts              ActivityAttempt[]
  recordings            Recording[]
  activityDrafts        ActivityDraft[]
  checkpointAssessments CheckpointAssessment[]

  @@unique([learnerId, clientSessionId])
  @@unique([id, learnerId])
  @@index([learnerId, status, createdAt])
  @@index([missionId])
  @@index([lessonVersionId])
}

model CheckpointAssessment {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId          String                   @db.Uuid
  clientAssessmentId String                   @db.Uuid
  sessionId          String                   @db.Uuid
  lessonVersionId    String                   @db.Uuid
  levelCode          String
  policyVersion      String
  status             String
  skills             Json
  reinforcement      Json
  evidenceSnapshot   Json
  canAdvance         Boolean
  nextLevelCode      String?
  createdAt          DateTime                 @default(now())
  learner            User                     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session            LearningSession          @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  lessonVersion      LessonVersion            @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  confirmation       ProgressionConfirmation?

  @@unique([learnerId, clientAssessmentId])
  @@unique([id, learnerId])
  @@index([learnerId, levelCode, createdAt])
  @@index([sessionId, learnerId])
  @@index([lessonVersionId])
}

model ProgressionConfirmation {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId     String               @db.Uuid
  assessmentId  String               @unique @db.Uuid
  fromLevelCode String
  toLevelCode   String?
  createdAt     DateTime             @default(now())
  learner       User                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  assessment    CheckpointAssessment @relation(fields: [assessmentId, learnerId], references: [id, learnerId], onDelete: Cascade)

  @@unique([assessmentId, learnerId])
  @@index([learnerId])
}

model SessionBlock {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String             @db.Uuid
  type          LearningBlockType
  order         Int
  targetMinutes Int
  activityIds   String[]           @db.Uuid
  status        SessionBlockStatus @default(AVAILABLE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  session       LearningSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
}

model ActivityAttempt {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId          String                  @db.Uuid
  sessionId          String                  @db.Uuid
  activityId         String                  @db.Uuid
  clientAttemptId    String                  @db.Uuid
  rawResponse        Json
  normalizedResponse Json?
  evaluationStatus   AttemptEvaluationStatus
  score              Float?
  feedback           String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  session            LearningSession         @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  activity           Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  masteryEvents      MasteryEvent[]
  recording          Recording?
  evaluationResults  EvaluationResult[]

  @@unique([learnerId, clientAttemptId])
  @@index([sessionId])
  @@index([activityId])
  @@index([sessionId, activityId])
}

model Recording {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId             String          @db.Uuid
  sessionId             String          @db.Uuid
  activityId            String          @db.Uuid
  attemptId             String          @unique @db.Uuid
  storageKey            String          @unique
  mimeType              String
  byteSize              Int
  checksum              String
  durationSeconds       Float?
  consentPolicyVersion  String
  consentScope          String
  consentAcceptedAt     DateTime
  transcript            String?
  speechMetrics         Json?
  providerName          String?
  providerConfigVersion String?
  retentionUntil        DateTime?
  deletionRequestedAt   DateTime?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  learner               User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session               LearningSession @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  activity              Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  attempt               ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@index([sessionId, learnerId])
  @@index([activityId])
  @@index([retentionUntil, deletedAt])
}

model EvaluationResult {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId               String          @db.Uuid
  lessonVersionId         String          @db.Uuid
  rubricId                String
  rubricVersion           String
  inputHash               String
  providerName            String
  providerModel           String?
  providerConfigVersion   String
  scores                  Json
  score                   Float
  feedback                Json
  speechMetricsProvenance Json?
  completedAt             DateTime
  createdAt               DateTime        @default(now())
  attempt                 ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lessonVersion           LessonVersion   @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, rubricVersion])
  @@index([attemptId, createdAt])
  @@index([lessonVersionId])
  @@index([completedAt])
}

model ActivityDraft {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId  String          @db.Uuid
  sessionId  String          @db.Uuid
  activityId String          @db.Uuid
  text       String
  revision   Int             @default(1)
  expiresAt  DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  learner    User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session    LearningSession @relation(fields: [sessionId, learnerId], references: [id, learnerId], onDelete: Cascade)
  activity   Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([learnerId, sessionId, activityId])
  @@index([sessionId, learnerId])
  @@index([activityId])
  @@index([expiresAt])
}

model ContentImport {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId          String?         @db.Uuid
  lessonVersionId   String?         @db.Uuid
  rawSource         String
  sourceHash        String
  status            ContentStatus   @default(DRAFT)
  draftRevision     Int             @default(1)
  parserVersion     String          @default("1.0.0")
  parsedAst         Json?
  normalizedPreview Json?
  validationReport  Json?
  validationHash    String?
  createdById       String          @db.Uuid
  updatedById       String          @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         User            @relation("ContentImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User            @relation("ContentImportUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  lesson            Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  publishedVersion  LessonVersion?  @relation(fields: [lessonVersionId], references: [id], onDelete: SetNull)
  audioArtifacts    AudioArtifact[]
  jobs              Job[]
  auditLogs         AuditLog[]

  @@index([lessonId])
  @@index([status])
}

enum AudioArtifactStatus {
  MISSING
  GENERATING
  READY
  FAILED
  STALE
}

model AudioArtifact {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentImportId         String                       @db.Uuid
  audioScriptSlug         String
  scriptHash              String
  adapterName             String
  voiceConfig             Json
  mimeType                String
  byteSize                Int
  checksum                String
  storageKey              String
  status                  AudioArtifactStatus          @default(MISSING)
  failureSummary          String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  contentImport           ContentImport                @relation(fields: [contentImportId], references: [id], onDelete: Cascade)
  lessonVersionReferences LessonVersionAudioArtifact[]

  @@unique([contentImportId, audioScriptSlug, scriptHash])
  @@index([contentImportId])
  @@index([status])
}

model LessonVersionAudioArtifact {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonVersionId String        @db.Uuid
  audioArtifactId String        @db.Uuid
  audioScriptSlug String
  createdAt       DateTime      @default(now())
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  audioArtifact   AudioArtifact @relation(fields: [audioArtifactId], references: [id], onDelete: Restrict)

  @@unique([lessonVersionId, audioScriptSlug])
  @@index([lessonVersionId])
  @@index([audioArtifactId])
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  COMPLETED
  FAILED
}

enum JobAttemptOutcome {
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String
  status          JobStatus      @default(PENDING)
  payload         Json
  result          Json?
  error           String?
  idempotencyKey  String         @unique @default(dbgenerated("gen_random_uuid()::text"))
  resourceType    String?
  resourceId      String?
  attemptCount    Int            @default(0)
  maxAttempts     Int            @default(3)
  availableAt     DateTime       @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  retryable       Boolean        @default(true)
  errorCode       String?
  errorSummary    String?
  startedAt       DateTime?
  completedAt     DateTime?
  contentImportId String?        @db.Uuid
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contentImport   ContentImport? @relation(fields: [contentImportId], references: [id], onDelete: SetNull)
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attempts        JobAttempt[]

  @@index([contentImportId])
  @@index([status])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([resourceType, resourceId])
}

model JobAttempt {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String            @db.Uuid
  attemptNumber Int
  outcome       JobAttemptOutcome @default(RUNNING)
  providerName  String?
  providerModel String?
  configVersion String?
  httpStatus    Int?
  errorCode     String?
  errorSummary  String?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
}

model MutationReceipt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String   @db.Uuid
  operation      String
  idempotencyKey String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey])
  @@index([actorId])
}

model AuditLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId         String         @db.Uuid
  action          String
  resourceType    String
  resourceId      String
  oldState        Json?
  newState        Json?
  metadata        Json?
  contentImportId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  actor           User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  contentImport   ContentImport? @relation(fields: [contentImportId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
}

enum MasteryState {
  NEW
  LEARNING
  REVIEW_DUE
  STABLE
  NEEDS_ATTENTION
}

enum MasteryEventType {
  CORRECT_RECALL
  ASSISTED_RECALL
  INCORRECT_ATTEMPT
  SUBMISSION_RECORDED
}

model MasteryRecord {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String         @db.Uuid
  languageBlockId     String         @db.Uuid
  skill               ActivityType
  state               MasteryState   @default(NEW)
  score               Float          @default(0.0)
  confidence          Float          @default(0.0)
  intervalDays        Float          @default(1.0)
  lastEvidenceAt      DateTime?
  nextReviewAt        DateTime?
  lastLessonVersionId String?        @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  learner             User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  languageBlock       LanguageBlock  @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lastLessonVersion   LessonVersion? @relation(fields: [lastLessonVersionId], references: [id], onDelete: SetNull)
  events              MasteryEvent[]

  @@unique([learnerId, languageBlockId, skill])
  @@index([learnerId, state, nextReviewAt])
  @@index([learnerId, skill])
  @@index([languageBlockId])
  @@index([nextReviewAt])
}

model MasteryEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId       String           @db.Uuid
  attemptId       String           @db.Uuid
  languageBlockId String           @db.Uuid
  skill           ActivityType
  lessonVersionId String           @db.Uuid
  masteryRecordId String?          @db.Uuid
  eventType       MasteryEventType
  score           Float
  metadata        Json?
  createdAt       DateTime         @default(now())
  learner         User             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  attempt         ActivityAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  languageBlock   LanguageBlock    @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lessonVersion   LessonVersion    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  masteryRecord   MasteryRecord?   @relation(fields: [masteryRecordId], references: [id], onDelete: SetNull)
  errorBankEntry  ErrorBankEntry?

  @@unique([attemptId, languageBlockId, skill])
  @@index([learnerId, createdAt])
  @@index([languageBlockId, skill])
  @@index([lessonVersionId])
  @@index([masteryRecordId])
}

enum ErrorType {
  ACTIVITY_INCORRECT
}

enum EvidenceGranularity {
  ACTIVITY
}

model ErrorBankEntry {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String              @db.Uuid
  masteryEventId      String              @unique @db.Uuid
  languageBlockId     String              @db.Uuid
  skill               ActivityType
  errorType           ErrorType           @default(ACTIVITY_INCORRECT)
  evidenceGranularity EvidenceGranularity @default(ACTIVITY)
  lessonVersionId     String              @db.Uuid
  activityId          String              @db.Uuid
  activitySlug        String
  contextKey          String
  occurredAt          DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  learner             User                @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  masteryEvent        MasteryEvent        @relation(fields: [masteryEventId], references: [id], onDelete: Cascade)
  languageBlock       LanguageBlock       @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lessonVersion       LessonVersion       @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  activity            Activity            @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([learnerId, skill])
  @@index([learnerId, languageBlockId])
  @@index([learnerId, contextKey])
  @@index([occurredAt])
}
