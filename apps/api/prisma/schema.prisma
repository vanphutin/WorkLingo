  action          String
  resourceType    String
  resourceId      String
  oldState        Json?
  newState        Json?
  metadata        Json?
  contentImportId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  actor           User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  contentImport   ContentImport? @relation(fields: [contentImportId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([actorId, createdAt])
}

enum MasteryState {
  NEW
  LEARNING
  REVIEW_DUE
  STABLE
  NEEDS_ATTENTION
}

enum MasteryEventType {
  CORRECT_RECALL
  ASSISTED_RECALL
  INCORRECT_ATTEMPT
  SUBMISSION_RECORDED
}

model MasteryRecord {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String         @db.Uuid
  languageBlockId     String         @db.Uuid
  skill               ActivityType
  state               MasteryState   @default(NEW)
  score               Float          @default(0.0)
  confidence          Float          @default(0.0)
  intervalDays        Float          @default(1.0)
  lastEvidenceAt      DateTime?
  nextReviewAt        DateTime?
  lastLessonVersionId String?        @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  learner             User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  languageBlock       LanguageBlock  @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lastLessonVersion   LessonVersion? @relation(fields: [lastLessonVersionId], references: [id], onDelete: SetNull)
  events              MasteryEvent[]

  @@unique([learnerId, languageBlockId, skill])
  @@index([learnerId, state, nextReviewAt])
  @@index([learnerId, skill])
  @@index([languageBlockId])
  @@index([nextReviewAt])
}

model MasteryEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId       String           @db.Uuid
  attemptId       String           @db.Uuid
  languageBlockId String           @db.Uuid
  skill           ActivityType
  lessonVersionId String           @db.Uuid
  masteryRecordId String?          @db.Uuid
  eventType       MasteryEventType
  score           Float
  metadata        Json?
  createdAt       DateTime         @default(now())
  learner         User             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  attempt         ActivityAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  languageBlock   LanguageBlock    @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lessonVersion   LessonVersion    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  masteryRecord   MasteryRecord?   @relation(fields: [masteryRecordId], references: [id], onDelete: SetNull)
  errorBankEntry  ErrorBankEntry?

  @@unique([attemptId, languageBlockId, skill])
  @@index([learnerId, createdAt])
  @@index([languageBlockId, skill])
  @@index([lessonVersionId])
  @@index([masteryRecordId])
}

enum ErrorType {
  ACTIVITY_INCORRECT
}

enum EvidenceGranularity {
  ACTIVITY
}

model ErrorBankEntry {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String              @db.Uuid
  masteryEventId      String              @unique @db.Uuid
  languageBlockId     String              @db.Uuid
  skill               ActivityType
  errorType           ErrorType           @default(ACTIVITY_INCORRECT)
  evidenceGranularity EvidenceGranularity @default(ACTIVITY)
  lessonVersionId     String              @db.Uuid
  activityId          String              @db.Uuid
  activitySlug        String
  contextKey          String
  occurredAt          DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  learner             User                @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  masteryEvent        MasteryEvent        @relation(fields: [masteryEventId], references: [id], onDelete: Cascade)
  languageBlock       LanguageBlock       @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lessonVersion       LessonVersion       @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  activity            Activity            @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([learnerId, skill])
  @@index([learnerId, languageBlockId])
  @@index([learnerId, contextKey])
  @@index([occurredAt])
}

enum EngagementWeekStatus {
  ACTIVE
  MET
  MISSED
}

model LearnerStudyDay {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId             String                @db.Uuid
  dateKey               String
  timezone              String
  completedSessionCount Int                   @default(0)
  firstCompletedAt      DateTime              @default(now())
  lastCompletedAt       DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  learner               User                  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  sessions              LearnerStudySession[]

  @@unique([learnerId, dateKey])
  @@index([learnerId, dateKey])
}

model LearnerStudySession {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId   String          @db.Uuid
  studyDayId  String          @db.Uuid
  sessionId   String          @unique @db.Uuid
  completedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  learner     User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  studyDay    LearnerStudyDay @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  session     LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([learnerId, studyDayId])
  @@index([studyDayId])
}

model LearnerEngagementWeek {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId    String               @db.Uuid
  weekStartKey String
  timezone     String
  targetDays   Int
  status       EngagementWeekStatus @default(ACTIVE)
  metAt        DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  learner      User                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, weekStartKey])
  @@index([learnerId, weekStartKey])
  @@index([learnerId, status])
}

model RateLimitBucket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String
  subjectHash String
  windowStart DateTime
  consumed    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, subjectHash, windowStart])
  @@index([scope, subjectHash])
  @@index([windowStart])
}

enum PilotMetricEventType {
  REGISTRATION_COMPLETED
  ONBOARDING_CONFIRMED
  LEARNING_SESSION_STARTED
  LEARNING_SESSION_COMPLETED
  LEARNING_SESSION_RESUMED
  PLACEMENT_CONFIRMED
  EVALUATION_TERMINAL
  CONTENT_IMPORT_VALIDATED
  CONTENT_PUBLISHED
  ENGAGEMENT_TARGET_MET
}

model PilotMetricDaily {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateKey      String
  eventType    PilotMetricEventType
  dimensionKey String
  dimensions   Json
  count        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([dateKey, eventType, dimensionKey])
  @@index([dateKey, eventType])
  @@index([updatedAt])
}

model PilotMetricReceipt {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceHash String               @unique
  eventType  PilotMetricEventType
  createdAt  DateTime             @default(now())

  @@index([createdAt])
}


// Additive master catalog: legacy identities and snapshots remain authoritative.
model VocabularySource {
  id                      String                 @id @default(uuid()) @db.Uuid
  providerName            String
  title                   String
  sourceUrl               String
  languageCode            String                 @default("en")
  rightsStatus            String                 @default("PENDING")
  permissionReference     String?
  allowedUses             String[]               @default([])
  allowedFields           String[]               @default([])
  attributionRequirements String                 @default("")
  revision                Int                    @default(1)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  documents               VocabularyDocument[]
  pronunciations          LexicalPronunciation[]
  senses                  LexicalSense[]

  @@unique([providerName, sourceUrl])
}

model VocabularyDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  sourceId         String                   @db.Uuid
  cefrLevel        String
  originalFilename String
  sourceUrl        String?
  sha256           String
  pageCount        Int
  edition          String                   @default("")
  acquiredAt       DateTime                 @default(now())
  source           VocabularySource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  batches          VocabularyBatch[]
  entries          VocabularySourceEntry[]
  topics           VocabularyTopicMapping[]

  @@unique([sourceId, sha256, cefrLevel])
  @@index([sourceId])
}

model VocabularyBatch {
  id                 String                        @id @default(uuid()) @db.Uuid
  documentId         String                        @db.Uuid
  parserVersion      String
  status             String                        @default("REGISTERED")
  inventory          Json
  inventoryHash      String
  detectedRows       Int
  checkpoint         Int                           @default(0)
  revision           Int                           @default(1)
  reviewedBy         String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  rollbackReason     String?
  createdAt          DateTime                      @default(now())
  document           VocabularyDocument            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  rows               VocabularyBatchRow[]
  collectionVersions VocabularyCollectionVersion[]

  @@unique([documentId, parserVersion])
  @@index([status, createdAt])
}

model VocabularySourceEntry {
  id                   String                     @id @default(uuid()) @db.Uuid
  documentId           String                     @db.Uuid
  sourceEntryKey       String
  topicInstanceKey     String
  originalTopic        String
  topicSequence        Int
  rowOrdinal           Int
  pageIndex            Int
  printedPageNumber    String?
  locations            Json
  rawWord              String
  parsedWord           String
  rawPos               String
  normalizedPos        String
  cefrLevel            String
  pronunciation        String?
  permittedDefinition  String?
  extractionConfidence Float                      @default(1)
  warnings             String[]                   @default([])
  sourceContentHash    String
  createdAt            DateTime                   @default(now())
  document             VocabularyDocument         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  batches              VocabularyBatchRow[]
  resolution           VocabularyEntryResolution?
  cefrAssociations     LexicalCefrAssociation[]

  @@unique([documentId, sourceEntryKey])
  @@index([documentId, pageIndex])
}

model VocabularyBatchRow {
  batchId         String                @db.Uuid
  sourceEntryId   String                @db.Uuid
  validationState String                @default("REVIEW_REQUIRED")
  rejectionReason String?
  batch           VocabularyBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceEntry     VocabularySourceEntry @relation(fields: [sourceEntryId], references: [id], onDelete: Restrict)

  @@id([batchId, sourceEntryId])
  @@index([sourceEntryId])
}

model LexicalEntry {
  id               String                       @id @default(uuid()) @db.Uuid
  language         String                       @default("en")
  canonicalForm    String
  normalizedForm   String
  lemma            String?
  entryType        String                       @default("WORD")
  partOfSpeech     String
  editorialStatus  String                       @default("DRAFT")
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  senses           LexicalSense[]
  pronunciations   LexicalPronunciation[]
  topics           LexicalEntryTopic[]
  cefrAssociations LexicalCefrAssociation[]
  resolutions      VocabularyEntryResolution[]
  members          VocabularyCollectionMember[]

  @@index([language, normalizedForm, partOfSpeech])
  @@index([editorialStatus, id])
}

model LexicalSense {
  id                 String                       @id @default(uuid()) @db.Uuid
  lexicalEntryId     String                       @db.Uuid
  senseKey           String
  definition         String?
  definitionLanguage String                       @default("en")
  translation        String?
  usageDomain        String?
  register           String?
  rightsBasis        String
  sourceId           String?                      @db.Uuid
  editorialStatus    String                       @default("DRAFT")
  createdAt          DateTime                     @default(now())
  entry              LexicalEntry                 @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  source             VocabularySource?            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  resolutions        VocabularyEntryResolution[]
  cefrAssociations   LexicalCefrAssociation[]
  members            VocabularyCollectionMember[]
  legacyLinks        VocabularyLegacyLink[]

  @@unique([lexicalEntryId, senseKey])
  @@unique([id, lexicalEntryId])
  @@index([sourceId])
}

model VocabularyEntryResolution {
  sourceEntryId  String                @id @db.Uuid
  lexicalEntryId String                @db.Uuid
  senseId        String                @db.Uuid
  decision       String
  reviewedBy     String
  reviewedAt     DateTime              @default(now())
  sourceEntry    VocabularySourceEntry @relation(fields: [sourceEntryId], references: [id], onDelete: Restrict)
  entry          LexicalEntry          @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  sense          LexicalSense          @relation(fields: [senseId, lexicalEntryId], references: [id, lexicalEntryId], onDelete: Restrict)

  @@index([lexicalEntryId])
  @@index([senseId, lexicalEntryId])
}

model LexicalPronunciation {
  id                  String            @id @default(uuid()) @db.Uuid
  lexicalEntryId      String            @db.Uuid
  dialect             String
  ipa                 String
  sourceId            String?           @db.Uuid
  rightsBasis         String
  reviewStatus        String            @default("REVIEW_REQUIRED")
  audioAssetReference String?
  entry               LexicalEntry      @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  source              VocabularySource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([lexicalEntryId])
  @@index([sourceId])
}

model LexicalCefrAssociation {
  id             String                @id @default(uuid()) @db.Uuid
  lexicalEntryId String                @db.Uuid
  senseId        String?               @db.Uuid
  sourceEntryId  String                @db.Uuid
  cefrLevel      String
  confidence     Float                 @default(1)
  reviewStatus   String                @default("REVIEWED")
  entry          LexicalEntry          @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  sense          LexicalSense?         @relation(fields: [senseId, lexicalEntryId], references: [id, lexicalEntryId], onDelete: Restrict)
  sourceEntry    VocabularySourceEntry @relation(fields: [sourceEntryId], references: [id], onDelete: Restrict)

  @@unique([sourceEntryId, cefrLevel])
  @@index([lexicalEntryId, cefrLevel])
  @@index([senseId, lexicalEntryId])
  @@index([cefrLevel])
}

model LexicalEntryTopic {
  lexicalEntryId String                 @db.Uuid
  topicGroupId   String                 @db.Uuid
  entry          LexicalEntry           @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  topic          IntermediateTopicGroup @relation(fields: [topicGroupId], references: [id], onDelete: Restrict)

  @@id([lexicalEntryId, topicGroupId])
  @@index([topicGroupId])
}

model VocabularyTopicMapping {
  documentId       String                  @db.Uuid
  topicInstanceKey String
  originalTopic    String
  topicGroupId     String?                 @db.Uuid
  document         VocabularyDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  topic            IntermediateTopicGroup? @relation(fields: [topicGroupId], references: [id], onDelete: Restrict)

  @@id([documentId, topicInstanceKey])
  @@index([topicGroupId])
}

model VocabularyCollection {
  id             String                        @id @default(uuid()) @db.Uuid
  name           String
  type           String
  ownerReference String
  createdAt      DateTime                      @default(now())
  versions       VocabularyCollectionVersion[]
}

model VocabularyCollectionVersion {
  id           String                        @id @default(uuid()) @db.Uuid
  collectionId String                        @db.Uuid
  version      Int
  status       String                        @default("DRAFT")
  batchId      String?                       @db.Uuid
  publishedAt  DateTime?
  createdAt    DateTime                      @default(now())
  collection   VocabularyCollection          @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  batch        VocabularyBatch?              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  members      VocabularyCollectionMember[]
  bindings     VocabularyCurriculumBinding[]

  @@unique([collectionId, version])
  @@unique([batchId])
  @@index([status, id])
}

model VocabularyCollectionMember {
  id                  String                        @id @default(uuid()) @db.Uuid
  collectionVersionId String                        @db.Uuid
  lexicalEntryId      String                        @db.Uuid
  senseId             String                        @db.Uuid
  position            Int
  version             VocabularyCollectionVersion   @relation(fields: [collectionVersionId], references: [id], onDelete: Restrict)
  entry               LexicalEntry                  @relation(fields: [lexicalEntryId], references: [id], onDelete: Restrict)
  sense               LexicalSense                  @relation(fields: [senseId, lexicalEntryId], references: [id, lexicalEntryId], onDelete: Restrict)
  assignments         VocabularyProgramAssignment[]

  @@unique([collectionVersionId, position])
  @@unique([collectionVersionId, senseId])
  @@index([lexicalEntryId])
  @@index([senseId, lexicalEntryId])
}

model VocabularyProgramAssignment {
  id              String                     @id @default(uuid()) @db.Uuid
  memberId        String                     @db.Uuid
  programId       String                     @db.Uuid
  targetLevel     String?
  priority        Int                        @default(0)
  learningGoal    String
  skills          String[]                   @default([])
  inclusionReason String
  curationStatus  String                     @default("REVIEW_REQUIRED")
  approvedBy      String?
  member          VocabularyCollectionMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program         LearningProgram            @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([memberId, programId])
  @@index([programId])
}

model VocabularyCurriculumBinding {
  id                  String                      @id @default(uuid()) @db.Uuid
  collectionVersionId String                      @db.Uuid
  programId           String?                     @db.Uuid
  pathId              String?                     @db.Uuid
  levelId             String?                     @db.Uuid
  missionId           String?                     @db.Uuid
  lessonVersionId     String?                     @db.Uuid
  wordBankVersionId   String?                     @db.Uuid
  version             VocabularyCollectionVersion @relation(fields: [collectionVersionId], references: [id], onDelete: Restrict)
  program             LearningProgram?            @relation(fields: [programId], references: [id], onDelete: Restrict)
  path                LearningPath?               @relation(fields: [pathId], references: [id], onDelete: Restrict)
  level               Level?                      @relation(fields: [levelId], references: [id], onDelete: Restrict)
  mission             Mission?                    @relation(fields: [missionId], references: [id], onDelete: Restrict)
  lessonVersion       LessonVersion?              @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  wordBankVersion     WordBankVersion?            @relation(fields: [wordBankVersionId], references: [id], onDelete: Restrict)

  @@index([collectionVersionId])
  @@index([programId])
  @@index([pathId])
  @@index([levelId])
  @@index([missionId])
  @@index([lessonVersionId])
  @@index([wordBankVersionId])
}

model VocabularyLegacyLink {
  id              String        @id @default(uuid()) @db.Uuid
  senseId         String        @db.Uuid
  languageBlockId String        @unique @db.Uuid
  reviewedBy      String
  reviewedAt      DateTime      @default(now())
  sense           LexicalSense  @relation(fields: [senseId], references: [id], onDelete: Restrict)
  languageBlock   LanguageBlock @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)

  @@index([senseId])
}
