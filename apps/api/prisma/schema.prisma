enum JobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  COMPLETED
  FAILED
}

enum JobAttemptOutcome {
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String
  status          JobStatus      @default(PENDING)
  payload         Json
  result          Json?
  error           String?
  idempotencyKey  String         @unique @default(dbgenerated("gen_random_uuid()::text"))
  resourceType    String?
  resourceId      String?
  attemptCount    Int            @default(0)
  maxAttempts     Int            @default(3)
  availableAt     DateTime       @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  retryable       Boolean        @default(true)
  errorCode       String?
  errorSummary    String?
  startedAt       DateTime?
  completedAt     DateTime?
  contentImportId String?        @db.Uuid
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contentImport   ContentImport? @relation(fields: [contentImportId], references: [id], onDelete: SetNull)
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attempts        JobAttempt[]

  @@index([contentImportId])
  @@index([status])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([resourceType, resourceId])
}

model JobAttempt {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String            @db.Uuid
  attemptNumber Int
  outcome       JobAttemptOutcome @default(RUNNING)
  providerName  String?
  providerModel String?
  configVersion String?
  httpStatus    Int?
  errorCode     String?
  errorSummary  String?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
}

model MutationReceipt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String   @db.Uuid
  operation      String
  idempotencyKey String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, idempotencyKey])
  @@index([actorId])
}

model AuditLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId         String         @db.Uuid
  action          String
  resourceType    String
  resourceId      String
  oldState        Json?
  newState        Json?
  metadata        Json?
  contentImportId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  actor           User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  contentImport   ContentImport? @relation(fields: [contentImportId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([actorId, createdAt])
}

enum MasteryState {
  NEW
  LEARNING
  REVIEW_DUE
  STABLE
  NEEDS_ATTENTION
}

enum MasteryEventType {
  CORRECT_RECALL
  ASSISTED_RECALL
  INCORRECT_ATTEMPT
  SUBMISSION_RECORDED
}

model MasteryRecord {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String         @db.Uuid
  languageBlockId     String         @db.Uuid
  skill               ActivityType
  state               MasteryState   @default(NEW)
  score               Float          @default(0.0)
  confidence          Float          @default(0.0)
  intervalDays        Float          @default(1.0)
  lastEvidenceAt      DateTime?
  nextReviewAt        DateTime?
  lastLessonVersionId String?        @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  learner             User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  languageBlock       LanguageBlock  @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lastLessonVersion   LessonVersion? @relation(fields: [lastLessonVersionId], references: [id], onDelete: SetNull)
  events              MasteryEvent[]

  @@unique([learnerId, languageBlockId, skill])
  @@index([learnerId, state, nextReviewAt])
  @@index([learnerId, skill])
  @@index([languageBlockId])
  @@index([nextReviewAt])
}

model MasteryEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId       String           @db.Uuid
  attemptId       String           @db.Uuid
  languageBlockId String           @db.Uuid
  skill           ActivityType
  lessonVersionId String           @db.Uuid
  masteryRecordId String?          @db.Uuid
  eventType       MasteryEventType
  score           Float
  metadata        Json?
  createdAt       DateTime         @default(now())
  learner         User             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  attempt         ActivityAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  languageBlock   LanguageBlock    @relation(fields: [languageBlockId], references: [id], onDelete: Restrict)
  lessonVersion   LessonVersion    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  masteryRecord   MasteryRecord?   @relation(fields: [masteryRecordId], references: [id], onDelete: SetNull)
  errorBankEntry  ErrorBankEntry?

  @@unique([attemptId, languageBlockId, skill])
  @@index([learnerId, createdAt])
  @@index([languageBlockId, skill])
  @@index([lessonVersionId])
  @@index([masteryRecordId])
}

enum ErrorType {
  ACTIVITY_INCORRECT
}

enum EvidenceGranularity {
  ACTIVITY
}

model ErrorBankEntry {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId           String              @db.Uuid
  masteryEventId      String              @unique @db.Uuid
  languageBlockId     String              @db.Uuid
